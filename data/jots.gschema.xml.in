<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="@APP_ID@.list-prefix">
    <value value='0' nick="disabled"/>
    <value value='1' nick="bullet"/>
    <value value='2' nick="dash"/>
    <value value='3' nick="wave"/>
    <value value='4' nick="dot"/>
  </enum>

  <schema path="@APP_PATH@/" id="@APP_ID@">
		<key name="scribbly-mode-active" type="b">
			<default>false</default>
			<summary>Change font to an illegible one</summary>
			<description>Whether to change font to an illegible one for unfocused sticky notes, for privacy</description>
		</key>
		<key name="hide-bar" type="b">
			<default>false</default>
			<summary>Hide actionbar</summary>
			<description>Whether to hide the actionbar and its buttons</description>
		</key>
		<key enum="@APP_ID@.list-prefix" name="list-prefix">
      		<default>'bullet'</default>
      		<summary>List item prefix</summary>
      		<description>The string to use at the start of a list item</description>
    	</key>
		<key name="autostart" type="b">
			<default>false</default>
			<summary>Autostart the app</summary>
			<description>Reflects actual autostart registration state. Synced with filesystem on startup.</description>
		</key>
		<key name="use-custom-fonts" type="b">
			<default>false</default>
			<summary>Use custom fonts</summary>
			<description>Whether to override system default fonts with user selected fonts</description>
		</key>
		<key name="default-font" type="s">
			<default>''</default>
			<summary>Default note font</summary>
			<description>Custom font description for standard sticky notes</description>
		</key>
		<key name="monospace-font" type="s">
			<default>''</default>
			<summary>Monospace note font</summary>
			<description>Custom font description for monospace sticky notes</description>
		</key>
		<key name="jorts-migration-prompted" type="b">
			<default>false</default>
			<summary>Whether the first-run Jorts migration prompt was shown</summary>
			<description>Tracks if user has been offered to import notes from Jorts on initial startup</description>
		</key>
	</schema>
</schemalist>
