<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>@APP_ID@</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0+</project_license>
    <launchable type="desktop-id">@APP_ID@.desktop</launchable>
    <translation type="gettext">@APP_ID@</translation>

    <name>Jots</name>
    <summary>Lightweight, colourful desktop sticky notes with Markdown and AI integration</summary>
    <description>
        <p>A lightweight, elegant sticky notes application for the modern Linux desktop with Markdown support, full-text search, and AI assistant integration.</p>
        <p>Features include:</p>
        <ul>
            <li>Markdown Storage &amp; Live Rendering: Plaintext Markdown files with real-time formatting for headings, lists, interactive checklists (- [ ]), and code blocks</li>
            <li>Full-Text Search: Instant search across open and saved notes with relevance ranking and highlighted snippet previews (Ctrl+F)</li>
            <li>AI Assistant Integration: Native Model Context Protocol (MCP) server over stdio for Claude, Cursor, and developer tools</li>
            <li>Colourful &amp; Accessible: Eleven pastel themes with automatically derived desaturated dark mode surfaces</li>
            <li>Private: Scribbly privacy mode (Ctrl+H) obfuscates text when notes are unfocused or during screen sharing</li>
            <li>Customizable Typography: Configure custom fonts and zoom scaling for standard and monospace notes</li>
            <li>Jorts Migration Helper: Non-destructive import wizard to safely copy existing notes from Jorts</li>
        </ul>
    </description>

    <developer id="io.github.@PUBLISHER@">
        <name>Jots Contributors</name>
    </developer>
    <project_group>@PUBLISHER@</project_group>
    <url type="homepage">https://github.com/@PUBLISHER@/@APP_NAME@</url>
    <url type="help">https://github.com/@PUBLISHER@/@APP_NAME@/discussions</url>
    <url type="translate">https://github.com/@PUBLISHER@/@APP_NAME@/blob/main/po/README.md</url>
    <url type="vcs-browser">https://github.com/@PUBLISHER@/@APP_NAME@</url>
    <content_rating type="oars-1.1"/>
    <branding>
      <color type="primary" scheme_preference="light">#64baff</color>
      <color type="primary" scheme_preference="dark">#002e99</color>
    </branding>
    <keywords>
        <keyword>Sticky notes</keyword>
        <keyword>Sticky note</keyword>
        <keyword>Stickies</keyword>
        <keyword>Colourful</keyword>
        <keyword>Notes</keyword>
        <keyword>Markdown</keyword>
        <keyword>Search</keyword>
        <keyword>MCP</keyword>
        <keyword>Desktop</keyword>
        <keyword>Reminder</keyword>
        <keyword>Utility</keyword>
        <keyword>GNOME</keyword>
        <keyword>Linux</keyword>
        <keyword>GTK</keyword>
    </keywords>
    <suggests>
        <id>io.github.comicdeed.reminduck</id>
        <id>com.github.elfenware.badger</id>
        <id>io.github.xchan14.larawan</id>
    </suggests>
    <recommends>
      <control>keyboard</control>
      <control>pointing</control>
      <control>touch</control>
    </recommends>

    <screenshots>
        <screenshot type="default">
            <caption>Sticky notes with colourful pastel themes, live Markdown rendering, and checklists</caption>
            <image>https://raw.githubusercontent.com/@PUBLISHER@/@APP_NAME@/@APP_VERSION@/data/screenshots/jots-light.png</image>
        </screenshot>
        <screenshot>
            <caption>Sticky notes with high-contrast desaturated colors in dark mode</caption>
            <image>https://raw.githubusercontent.com/@PUBLISHER@/@APP_NAME@/@APP_VERSION@/data/screenshots/jots-dark.png</image>
        </screenshot>
        <screenshot>
            <caption>Streaming? Worried of someone looking above your shoulder? Try the Scribbly Mode!</caption>
            <image>https://raw.githubusercontent.com/@PUBLISHER@/@APP_NAME@/@APP_VERSION@/data/screenshots/scribbly.png</image>
        </screenshot>
        <screenshot>
            <caption>The preferences dialog in light mode</caption>
            <image>https://raw.githubusercontent.com/@PUBLISHER@/@APP_NAME@/@APP_VERSION@/data/screenshots/preferences-light.png</image>
        </screenshot>
        <screenshot>
            <caption>The preferences dialog in dark mode</caption>
            <image>https://raw.githubusercontent.com/@PUBLISHER@/@APP_NAME@/@APP_VERSION@/data/screenshots/preferences-dark.png</image>
        </screenshot>
    </screenshots>

    <releases>
        <release version="1.3.0-beta.5" type="development" date="2026-08-31">
            <description>
                <p>This beta introduces automated Git backup and remote sync alongside major window lifecycle stability improvements.</p>
                <p>Changes in this beta:</p>
                <ul>
                    <li>Automated Git backup and sync keeps notes safely mirrored to remote repositories with background debouncing.</li>
                    <li>Added a dedicated Backup &amp; Sync tab in Preferences with connection testing and manual sync triggers.</li>
                    <li>Window destruction and note closing are significantly more stable without crash hazards.</li>
                    <li>Desktop dark mode and light mode transitions now sync reliably across all open sticky notes.</li>
                    <li>The Preferences dialog now closes smoothly with Escape or Ctrl+W.</li>
                    <li>Markdown front matter parsing is more robust against unexpected or non-numeric metadata values.</li>
                </ul>
                <p>Technical Notes:</p>
                <ul>
                    <li>Release automation directly uploads distribution packages to GitHub Releases, bypassing intermediate storage quotas.</li>
                    <li>Popovers attached to header bars are cleanly unparented during container disposal, preventing GTK finalization warnings.</li>
                    <li>Streamlined Vala signal lifecycle management to rely on automatic GObject weak binding semantics.</li>
                    <li>Added automated test coverage for non-numeric front matter fallback and strengthened integer boundary parsing.</li>
                </ul>
            </description>
        </release>
        <release version="1.3.0-beta.2" type="development" date="2026-08-30">
            <description>
                <p>This beta strengthens backup and sync behavior for first-time remote setup and branch-name edge cases.</p>
                <p>Changes in this beta:</p>
                <ul>
                    <li>Backup setup now handles empty local history more safely when the remote already contains notes history.</li>
                    <li>Remote content detection now recognizes common branch conventions such as main and master.</li>
                    <li>Backup and Sync preference ordering is clearer, with setup inputs and actions shown before status details.</li>
                    <li>Manual sync, retry, and status transitions are more consistent under active backup operations.</li>
                </ul>
                <p>Technical Notes:</p>
                <ul>
                    <li>Resolved Vala lint violations in branch divergence parsing and note identifier tests.</li>
                    <li>Expanded Git sync coverage for branch-name sanitization and remote head detection behavior.</li>
                </ul>
            </description>
        </release>
        <release version="1.3.0-beta.1" type="development" date="2026-08-30">
            <description>
                <p>This beta makes backup and sync setup more reliable and easier to understand in day-to-day use.</p>
                <p>Changes in this beta:</p>
                <ul>
                    <li>Backup and Sync now handles first-time remote setup more safely, including empty repositories and remotes that already have content.</li>
                    <li>Sync actions in Preferences are clearer, with controls shown first and status details shown after configuration inputs.</li>
                    <li>Remote status reporting is more consistent during retries, queueing, and active synchronization.</li>
                    <li>Connection checks and manual sync triggers are wired directly in Preferences for faster setup validation.</li>
                </ul>
                <p>Technical Notes:</p>
                <ul>
                    <li>Hardened GitSyncService branch resolution and empty-history handling for branch-name conventions like main and master.</li>
                    <li>Improved signal lifecycle cleanup and async state arbitration in backup orchestration paths.</li>
                </ul>
            </description>
        </release>
        <release version="1.2.0" date="2026-08-27">
            <description>
                <p>Jots 1.2.0 adds a built-in quick reference note and fine-grained per-note protection controls.</p>
                <p>Highlights:</p>
                <ul>
                    <li>Built-in Cheat Sheet (F1): Press F1 anytime to open, present, or recreate an indestructible read-only reference note listing all shortcuts and Markdown syntax</li>
                    <li>Per-Note Read-Only Lock: Toggle "Lock Note" in any note's popover menu to prevent accidental edits or deletions</li>
                    <li>Per-Note Privacy Exemption: Toggle "Always Visible" to exempt a specific note from Scribbly obfuscation, keeping reference material readable when unfocused</li>
                </ul>
            </description>
        </release>
        <release version="1.1.3" date="2026-08-26">
            <description>
                <p>Jots 1.1.3 introduces clean, crisp vector icon artwork across all themes and sizes.</p>
                <p>Highlights &amp; Fixes:</p>
                <ul>
                    <li>Crisp Solid Icon Artwork: Replaced noisy line hatching in application icons with a bold, solid calligraphic J that scales sharply on desktop menus, docks, and launchers without moiré aliasing</li>
                    <li>Preserved Original Hatching: Preserved the legacy hatched artwork as an optional icon variant</li>
                    <li>Packaging Cleanups: Ensured production AppImages always compile from a clean, non-cached build state</li>
                </ul>
            </description>
        </release>
        <release version="1.1.2" date="2026-08-26">
            <description>
                <p>Jots 1.1.2 streamlines project documentation and metadata to reflect universal Linux desktop support.</p>
                <p>Highlights &amp; Changes:</p>
                <ul>
                    <li>Universal Linux Documentation: Updated project README, build guides, and bug reporting templates to reflect pure GTK4 cross-desktop support</li>
                    <li>AppStream Metadata Cleanups: Modernized discovery keywords to align with general Linux and GNOME app ecosystems</li>
                </ul>
            </description>
        </release>
        <release version="1.1.1" date="2026-08-26">
            <description>
                <p>Jots 1.1.1 fixes standalone SVG icon rendering in AppImage packages and hardens packaging workflows.</p>
                <p>Highlights &amp; Fixes:</p>
                <ul>
                    <li>Bundled SVG Engine: Added librsvg2 and gdk-pixbuf SVG loader modules to CI runners and AppImage bundles to guarantee crisp magnifying glass zoom icons across all desktop environments</li>
                    <li>Packaging Guardrails: Added strict build assertions ensuring standalone SVG loaders are packaged in all AppImage builds</li>
                </ul>
            </description>
        </release>
        <release version="1.1.0" date="2026-08-26">
            <description>
                <p>Jots 1.1.0 is a major milestone delivering pure GTK4 architecture, standalone AppImage packages, discrete Cairo color styling, and cross-desktop theming.</p>
                <p>Major Highlights:</p>
                <ul>
                    <li>Pure GTK4 Migration: Completely removed Granite dependency for native, lightning-fast GTK4 execution across all Linux distributions</li>
                    <li>AppImage Distribution: Standalone click-and-run executables with bundled SVG engine and dual-entrypoint AI MCP server support (--mcp)</li>
                    <li>Cross-Desktop Theming: Automatic dark and light appearance synchronization via XDG Desktop Portal (GNOME, KDE Plasma, elementary OS, XFCE)</li>
                    <li>Custom Discrete Color Pills: Elementary-style circular color palette with matching accent selection rings and smooth hover feedback</li>
                    <li>Bundled Symbolic Icons: Crisp monochrome action and magnifying glass zoom icons embedded into GResource</li>
                    <li>Multi-Platform Packaging: Standalone offline Flatpak bundles and native Windows installer support</li>
                </ul>
            </description>
        </release>
        <release version="1.0.0" date="2026-08-25">
            <description>
                <p>Inaugural release of Jots — the next-generation lightweight sticky notes application, forked and evolved from Jorts 4.3.0.</p>
                <p>Major Highlights:</p>
                <ul>
                    <li>Full-Text Search: Real-time search popover querying live text buffers and saved notes with relevance scoring (Ctrl+F)</li>
                    <li>Markdown Storage &amp; Live Rendering: Individual Markdown file persistence with inline syntax rendering for headers, lists, checklists (- [ ]), and code blocks</li>
                    <li>Model Context Protocol (MCP) Server: Standalone native binary (jots-mcp) enabling AI assistants to securely read and create desktop sticky notes</li>
                    <li>Desaturated Dark Mode: High-contrast pastel color derivation optimized for dark themes and accessibility</li>
                    <li>Custom Typography: Configurable default and monospace note fonts in Preferences</li>
                    <li>Jorts Migration Helper: Non-destructive first-run prompt and Preferences tool to copy notes from existing Jorts installations</li>
                    <li>Scribbly Privacy Mode: Fixed dynamic font obfuscation when notes lose focus (Ctrl+H)</li>
                </ul>
            </description>
        </release>
        <release version="0.9.0" date="2026-07-07">
            <description>
                <p>Historical fork checkpoint based on Jorts 4.3.0 by Lains, Stella &amp; Charlie, and community contributors.</p>
            </description>
        </release>
    </releases>   
</component>
